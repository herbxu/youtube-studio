{
  "schema": "opinion-config/v1",
  "text": {
    "provider": "openai",
    "model": "gpt-4.1",
    "key_env": "OPENAI_API_KEY"
  },
  "voice": {
    "provider": "aliyun",
    "key_env": "ALIYUN_TTS_API_KEY",
    "timeout": 230,
    "settings": {
      "model": "qwen-audio-3.0-tts-plus",
      "voice_id": null
    }
  },
  "captions": {
    "punctuation": "none"
  },
  "alignment": {
    "provider": "faster-whisper",
    "model": "base",
    "allow_download": false,
    "min_coverage": 0.94,
    "threads": 4
  },
  "image": {
    "provider": "openai",
    "model": "gpt-image-1",
    "key_env": "OPENAI_API_KEY",
    "size": "1536x1024",
    "quality": "medium"
  },
  "style": {
    "id": "opinion-explainer/v1",
    "image_prompt": "仅用于需要原创比喻的局部插画。画面简洁、主体明确、浅纸色与深墨砖红协调。无文字、数字、标志或水印。不生成伪新闻照片，不模仿具体频道人物。"
  },
  "audio": {
    "lufs": -18
  },
  "render": {
    "fps": 30,
    "timeout": 3600
  }
}
